# ==============================================================================
# Telegram AI-Tutor & Multimodal Powerhouse (Antigravity Edition)
# Environment Configuration Template
# ==============================================================================

# ── Telegram Webhook & Credentials ───────────────────────────────────────────
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
WEBHOOK_URL=https://your-domain.ngrok-free.app
WEBHOOK_SECRET=your_super_secret_token_32_characters_random
WEBHOOK_PATH=/webhook

# ── External AI & Speech APIs ────────────────────────────────────────────────
# OpenRouter API Key (sk-or-v1-...) granting access to Claude, GPT-4o, Gemini, DeepSeek, Grok
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram API Key for Voice Transcription, Nova-3 speech recognition and Diarization
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Chess Engine ─────────────────────────────────────────────────────────────
# Path to Stockfish executable:
# Linux/macOS: /usr/bin/stockfish | /opt/homebrew/bin/stockfish
# Windows: C:\stockfish\stockfish.exe or stockfish
STOCKFISH_PATH=stockfish

# ── SQLite Database ──────────────────────────────────────────────────────────
DATABASE_PATH=bot_data.db
DATABASE_POOL_SIZE=5

# ── Webhook Server (FastAPI + Uvicorn) ────────────────────────────────────────
HOST=0.0.0.0
PORT=8443
LOG_LEVEL=INFO
